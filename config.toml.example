# The Halleen Machine 2.0 configuration
#
# Copy this file to config.toml and fill in the paths, or run `python setup.py`
# to have it written for you. Paths use forward slashes on every platform.
#
# THM does not install models or workflows. Bring your own ComfyUI workflows,
# tag them as WORKFLOWS.md describes, and put them in workflows_image/ or
# workflows_video/; whatever models they load are yours to have in ComfyUI.

[comfyui]
# ComfyUI's API address.
#   Local:            "http://127.0.0.1:8188"
#   Another machine:  "http://192.168.1.100:8188"
api_base = "http://127.0.0.1:8188"

# Where ComfyUI writes its renders (REQUIRED). THM reads every finished image
# and video from here, so it must be the folder ComfyUI itself saves to.
#   Windows:   "D:/ComfyUI/output"
#   Linux/Mac: "/home/username/ComfyUI/output"
output_root = ""

# How long one prompt may execute in ComfyUI before THM gives up on it, in
# seconds. Time spent waiting in the queue does not count. Video gets its own,
# longer limit.
timeout_seconds = 3600
video_timeout_seconds = 14400

[paths]
# Where projects are stored. "./projects" keeps them inside the repo; an
# absolute path keeps them anywhere else. `serve.py --projects-dir` overrides.
workspace = "./projects"

# ComfyUI's models/loras folder, listed by the LoRA picker. Optional.
#   Windows:   "D:/ComfyUI/models/loras"
#   Linux/Mac: "/home/username/ComfyUI/models/loras"
loras = ""

[backups]
# Project files are backed up before each write, at most once per throttle
# window; the oldest beyond retention are dropped.
retention = 50
throttle_seconds = 300
