config.toml
venv/
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.vscode/
_backups/

# user projects live here; the folder ships empty
projects/*
!projects/.gitkeep

# web client: dependencies are not tracked, the built dist/ is
web/node_modules/

# agent CLI session state
thm-agent/.state/

# the agent supervisor: its logs and pid files
thm_runner/logs/
thm_runner/*.pid

# per-tool venvs and model caches (thm-tools/<name>/): installed per machine
thm-tools/*/.venv/
thm-tools/*/models/

# maintainer-only: the dev -> staging sync, and local agent settings
_release/
.claude/

# Comfy API key for partner nodes (secret, never commit)
.comfy_api_key
projects/**/.comfy_api_key
